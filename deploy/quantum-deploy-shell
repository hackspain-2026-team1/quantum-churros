#!/usr/bin/env bash
set -Eeuo pipefail

readonly requested_command="${2:-}"

if [[ "${1:-}" != "-c" ]]; then
  echo "interactive access is disabled for quantum-deploy" >&2
  exit 64
fi

if [[ ! "$requested_command" =~ ^deploy\ ([0-9a-f]{40})\ ([[:alnum:]_.-]+)\ (sha256:[0-9a-f]{64})\ (sha256:[0-9a-f]{64})$ ]]; then
  echo "unsupported deployment command" >&2
  exit 64
fi

exec sudo -n /usr/local/sbin/quantum-churros-deploy "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
