#!/usr/bin/env bash
set -Eeuo pipefail

readonly release_sha="${1:-}"
readonly registry_user="${2:-}"
readonly api_digest="${3:-}"
readonly web_digest="${4:-}"
readonly deploy_dir="/opt/quantum-churros"
readonly compose_file="$deploy_dir/compose.yaml"
readonly config_env="$deploy_dir/.env"
readonly release_env="$deploy_dir/.release.env"
readonly registry="ghcr.io"
readonly image_prefix="ghcr.io/hackspain-2026-team1/quantum-churros"

if [[ ! "$release_sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "release SHA must contain exactly 40 lowercase hexadecimal characters" >&2
  exit 64
fi

if [[ ! "$registry_user" =~ ^[[:alnum:]_.-]+$ ]]; then
  echo "registry user contains unsupported characters" >&2
  exit 64
fi

if [[ ! "$api_digest" =~ ^sha256:[0-9a-f]{64}$ || ! "$web_digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
  echo "image digests must use the sha256 format" >&2
  exit 64
fi

IFS= read -r registry_token || true
if [[ -z "$registry_token" ]]; then
  echo "a GHCR token is required on stdin" >&2
  exit 64
fi

exec 9>/var/lock/quantum-churros-deploy.lock
flock 9
umask 077

previous_api_image=""
previous_web_image=""
if [[ -f "$release_env" ]]; then
  previous_api_image=$(awk -F= '$1 == "API_IMAGE" {print substr($0, index($0, "=") + 1)}' "$release_env")
  previous_web_image=$(awk -F= '$1 == "WEB_IMAGE" {print substr($0, index($0, "=") + 1)}' "$release_env")
fi

readonly api_image="$image_prefix-api@$api_digest"
readonly web_image="$image_prefix-web@$web_digest"
release_changed=0
deployment_succeeded=0

write_release() {
  local target_api="$1"
  local target_web="$2"
  local temporary_file
  temporary_file=$(mktemp "$deploy_dir/.release.env.XXXXXX")
  printf 'API_IMAGE=%s\nWEB_IMAGE=%s\n' "$target_api" "$target_web" > "$temporary_file"
  chmod 600 "$temporary_file"
  mv "$temporary_file" "$release_env"
}

compose() {
  docker compose --env-file "$config_env" --env-file "$release_env" -f "$compose_file" "$@"
}

finish() {
  local exit_code=$?
  docker logout "$registry" >/dev/null 2>&1 || true

  if [[ $deployment_succeeded -ne 1 && $release_changed -eq 1 && -n "$previous_api_image" && -n "$previous_web_image" ]]; then
    echo "deployment failed; restoring the previous application images" >&2
    write_release "$previous_api_image" "$previous_web_image"
    compose up -d --remove-orphans --wait --wait-timeout 180 || true
  fi

  if [[ $deployment_succeeded -eq 1 && $exit_code -eq 0 ]]; then
    echo "deployed $release_sha successfully"
  fi

  exit "$exit_code"
}
trap finish EXIT

printf '%s\n' "$registry_token" | docker login "$registry" --username "$registry_user" --password-stdin >/dev/null
write_release "$api_image" "$web_image"
release_changed=1

compose pull api web mailpit
compose run --rm --no-deps api xray-db verify-static-data /app/bundle /app/rumbo
compose up -d --remove-orphans --wait --wait-timeout 180
for path in / /data/v1/manifest.json /data/rumbo/params.json /data/rumbo/entities.json /data/rumbo/products/index.json /data/rumbo/horizons/index.json; do
  curl --fail --silent --show-error --max-time 15 "http://127.0.0.1:3101$path" >/dev/null
done

deployment_succeeded=1

if ! compose run --rm notifier; then
  echo "the notifier failed; the healthy API and web deployment remains active" >&2
  exit 70
fi
