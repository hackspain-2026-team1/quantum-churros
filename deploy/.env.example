# Plantilla para /opt/quantum-churros/.env (permisos 600, nunca se sube al repositorio).
# El script de despliegue añade API_IMAGE y WEB_IMAGE en .release.env; no los definas aquí.

# Requerida: contraseña de PostgreSQL.
POSTGRES_PASSWORD=change-me

# Origen público con el que se construyen los enlaces del correo y la CORS de la API.
ORIGIN=https://xray.example.test

# Puerto local del frontend, siempre ligado a 127.0.0.1.
WEB_PORT=3101

# Puerto local de la interfaz de Mailpit, siempre ligado a 127.0.0.1.
MAILPIT_HTTP_PORT=8025
