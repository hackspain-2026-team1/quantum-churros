{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-churros.dev/contracts/score-snapshot.schema.json",
  "title": "ScoreSnapshot",
  "type": "object",
  "required": ["entity_id", "month", "score", "observed_score", "predicted_future_score", "forecast_delta", "delta", "trend", "persistence_months", "confidence", "drivers", "shap_base_value", "explanation_residual", "feature_version", "model_version", "dataset_hash"],
  "properties": {
    "entity_id": { "type": "string" },
    "month": { "type": "string", "format": "date" },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "observed_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "predicted_future_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "forecast_delta": { "type": "number" },
    "delta": { "type": "number" },
    "trend": { "enum": ["improving", "stable", "deteriorating"] },
    "persistence_months": { "type": "integer", "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "drivers": { "type": "array", "items": { "type": "object" } },
    "shap_base_value": { "type": "number" },
    "explanation_residual": { "type": "number" },
    "detected_since": { "type": ["string", "null"], "format": "date" },
    "feature_version": { "type": "string" },
    "model_version": { "type": "string" },
    "dataset_hash": { "type": "string" }
  }
}
